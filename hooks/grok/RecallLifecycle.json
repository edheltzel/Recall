{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${RECALL_DIR:-$(printf %s ~)/.agents/Recall}/grok/hooks/capture.ts\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${RECALL_DIR:-$(printf %s ~)/.agents/Recall}/grok/hooks/capture.ts\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${RECALL_DIR:-$(printf %s ~)/.agents/Recall}/grok/hooks/capture.ts\"",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${RECALL_DIR:-$(printf %s ~)/.agents/Recall}/grok/hooks/capture.ts\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
